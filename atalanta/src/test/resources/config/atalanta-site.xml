    <name>atalanta.disable.table.timeout.ms</name>
    <value>600000</value>
  </property>
  <property>
    <name>atalanta.drop.table.timeout.ms</name>
    <value>600000</value>
  </property>
  <property>
    <name>atalanta.security.token.retry.timeout.ms</name>
    <value>1000</value>
  </property>
  <property>
    <name>atalanta.security.token.retry.count</name>
    <value>5</value>
  </property>
