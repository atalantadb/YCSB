<configuration>
  <property>
    <name>atalanta.zookeeper.connection.string</name>
    <value>localhost:2181</value>
  </property>
  <property>
    <name>atalanta.zookeeper.path</name>
    <value>/atalanta</value>
  </property>
  <property>
    <name>atalanta.zookeeper.retry.count</name>
    <value>5</value>
  </property>
  <property>
    <name>atalanta.zookeeper.retry.delay.ms</name>
    <value>3000</value>
  </property>
  <property>
    <name>atalanta.security.authentication</name>
    <value>NONE</value>
  </property>
  <property>
    <name>atalanta.security.spn</name>
    <value>atalanta</value>
  </property>
  <property>
    <name>atalanta.security.login</name>
    <value>atalanta-client</value>
  </property>
  <property>
